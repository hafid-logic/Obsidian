filters:
  and:
    - file.inFolder("Chats")
    - file.hasLink(this.file.name)
formulas:
  status_icon: 'if(status == "processed", "✅", if(status == "new", "🆕", if(status == "archived", "🗄️", if(status == "example", "📘", "⚪"))))'
  open_url: 'if(url, link(url, "Source"), "")'
properties:
  chat_date:
    displayName: "Date"
  formula.status_icon:
    displayName: "Status"
  formula.open_url:
    displayName: "Source"
views:
  - type: table
    name: "Project Chats"
    order:
      - chat_date
      - file.name
      - formula.status_icon
      - formula.open_url
